# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (for email notifications)
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxx

# Base URL (for email links)
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# Cron job secret (for Vercel cron authentication)
# Generate a random string for security
CRON_SECRET=your-random-secret-string

# Admin portal password
ADMIN_PASSWORD=your-admin-password

# Whop Payment Integration
WHOP_API_KEY=your-whop-api-key
WHOP_WEBHOOK_SECRET=your-whop-webhook-secret
WHOP_VERIFIED_PRODUCT_ID=prod_xxx
WHOP_PREMIUM_PRODUCT_ID=prod_xxx
# Where site-owned "match me" leads are emailed (the operator's inbox)
LEAD_NOTIFY_EMAIL=you@example.com
REPORT_SIGNING_SECRET=  # signs /report links; any long random string

# Connect line (Twilio). Leave TWILIO_CONNECT_NUMBERS empty to keep it off.
# Each pool number's Voice webhook must POST to https://www.georgiagapp.com/api/connect/voice
TWILIO_AUTH_TOKEN=            # from the Twilio console; verifies webhook signatures
TWILIO_CONNECT_NUMBERS=       # comma-separated E.164 pool numbers, e.g. +14045550001,+14045550002
CONNECT_FALLBACK_PHONE=       # optional; where a call lands when the agency does not pick up (default: the site helpline)
